# CoreWatch 환경 설정 예시 — 이 파일을 복사해 .env를 만들고 값을 채운다.
#   cp .env.example .env
# .env는 .gitignore에 등록돼 있어 Git에 올라가지 않는다. 실제 키는 .env에만 넣을 것.

# ---- 데이터 모드 ----
# synthetic : 독립 합성 데이터 (기본값, 외부 LLM·LangSmith·발표 시연용)
# original  : SK 제공 원본 엑셀 (로컬 Ollama 전용 — 외부 API·LangSmith 사용 금지)
DATA_MODE=synthetic
# 원본 엑셀 위치가 기본 경로(../Data/)와 다르면 지정
# CW_DATA_PATH=~/SKALA/03_mini_project/Data/Infra센터_Guided_PJT_Topic_3_Data_(5g_ss_mme).xlsx

# ---- AI 모델 ----
# fake(기본, 외부 호출 없음) | ollama(로컬 모델) | openai(합성 데이터 모드에서만)
LLM_BACKEND=fake
# 위험 조치(재기동 등)가 있으면 운영자 승인을 기다릴지 (true 권장)
HITL_ENABLED=true

# ---- LangSmith 추적 (합성 데이터 모드에서만 켤 것) ----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=corewatch
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---- OpenAI (LLM_BACKEND=openai, 합성 데이터 모드에서만 · 과금) ----
OPENAI_API_KEY=sk-...
# OPENAI_FAST_MODEL=gpt-4o-mini
# OPENAI_QUALITY_MODEL=gpt-4o
